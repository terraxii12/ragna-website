---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('chapters', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.number - b.data.number
  );
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, number, part, interlude, summary, cover } = entry.data;
---
<Base title={title} description={summary} image={cover} chapterId={entry.id}>
  <article class="chapter">
    {cover && (
      <div class="cover">
        <img src={cover} alt="" />
      </div>
    )}

    <header class="chapter-head">
      <p class="eyebrow">{interlude ? 'Zwischenspiel' : `Kapitel ${number}`}{part ? ` · ${part}` : ''}</p>
      <h1>{title}</h1>
      <div class="divider" aria-hidden="true"><span>◆</span></div>
      <div class="tools" role="group" aria-label="Schriftgröße">
        <button type="button" data-size="down" aria-label="Schrift kleiner">A−</button>
        <button type="button" data-size="up" aria-label="Schrift größer">A+</button>
      </div>
    </header>

    <div class="frame reader">
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="chapter-nav" aria-label="Kapitelnavigation">
      {prev ? (
        <a class="prev" href={`/kapitel/${prev.id}/`}>
          <span>← Vorheriges Kapitel</span>
          <strong>{prev.data.title}</strong>
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={`/kapitel/${next.id}/`}>
          <span>Nächstes Kapitel →</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : (
        <span class="next end">Fortsetzung folgt …</span>
      )}
    </nav>
    <p class="back"><a href="/#kapitel">Zum Kapitelverzeichnis</a></p>
  </article>
</Base>
